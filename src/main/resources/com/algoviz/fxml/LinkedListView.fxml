<?xml version="1.0" encoding="UTF-8"?>

<?import com.algoviz.ui.component.ExplanationCard?>
<?import com.algoviz.ui.component.Legend?>
<?import com.algoviz.ui.component.MemoryView?>
<?import com.algoviz.ui.component.PlaybackBar?>
<?import com.algoviz.ui.component.PseudocodePanel?>
<?import com.algoviz.ui.render.LinkedListCanvas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.algoviz.controller.LinkedListController" styleClass="module-root">

    <FlowPane styleClass="toolbar-flow">
        <VBox styleClass="field">
            <Label text="Value" styleClass="field-label"/>
            <TextField fx:id="valueField" promptText="e.g. 17" prefWidth="90"/>
        </VBox>
        <VBox styleClass="field">
            <Label text="Index" styleClass="field-label"/>
            <TextField fx:id="indexField" promptText="0" prefWidth="64"/>
        </VBox>
        <VBox styleClass="field">
            <Label text="Insert" styleClass="field-label"/>
            <HBox styleClass="segmented">
                <Button fx:id="insertHeadButton" text="Head" onAction="#insertHead"/>
                <Button fx:id="insertTailButton" text="Tail" onAction="#insertTail"/>
                <Button fx:id="insertAtButton" text="At index" onAction="#insertAt"/>
            </HBox>
        </VBox>
        <VBox styleClass="field">
            <Label text="Delete" styleClass="field-label"/>
            <HBox styleClass="segmented">
                <Button fx:id="deleteHeadButton" text="Head" onAction="#deleteHead"/>
                <Button fx:id="deleteTailButton" text="Tail" onAction="#deleteTail"/>
                <Button fx:id="deleteAtButton" text="At index" onAction="#deleteAt"/>
            </HBox>
        </VBox>
        <VBox styleClass="field">
            <Label text="Explore" styleClass="field-label"/>
            <HBox spacing="8">
                <Button fx:id="searchButton" text="Search" onAction="#search"/>
                <Button fx:id="traverseButton" text="Traverse" onAction="#traverse"/>
                <Button fx:id="reverseButton" text="Reverse" styleClass="primary" onAction="#reverse"/>
            </HBox>
        </VBox>
        <VBox styleClass="field">
            <Label text="List" styleClass="field-label"/>
            <HBox spacing="8">
                <Button fx:id="sampleButton" text="Sample" onAction="#sample"/>
                <Button fx:id="clearButton" text="Clear" styleClass="danger" onAction="#clearList"/>
            </HBox>
        </VBox>
    </FlowPane>
    <Label fx:id="inputMessage" styleClass="inline-message"/>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.75">
        <VBox spacing="12" minWidth="460">
            <StackPane styleClass="canvas-card" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" fitToHeight="true" vbarPolicy="NEVER">
                    <LinkedListCanvas fx:id="canvas"/>
                </ScrollPane>
                <!-- Listed before the legend so the legend draws on top of it. -->
                <VBox fx:id="emptyHolder" styleClass="empty-overlay" StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"/>
                <Legend fx:id="legend" StackPane.alignment="TOP_LEFT">
                    <StackPane.margin><Insets top="10" left="12"/></StackPane.margin>
                </Legend>
            </StackPane>
            <MemoryView fx:id="memoryView"/>
            <PlaybackBar fx:id="playbackBar"/>
        </VBox>
        <ScrollPane fitToWidth="true" minWidth="340" hbarPolicy="NEVER">
            <VBox styleClass="side-panel">
                <ExplanationCard fx:id="explanationCard"/>
                <VBox styleClass="card">
                    <Label fx:id="codeTitle" text="Pseudocode" styleClass="card-title"/>
                    <PseudocodePanel fx:id="pseudocodePanel"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </SplitPane>
</VBox>
