<?xml version="1.0" encoding="UTF-8"?>

<?import com.algoviz.ui.component.ComplexityCard?>
<?import com.algoviz.ui.component.ExplanationCard?>
<?import com.algoviz.ui.component.Legend?>
<?import com.algoviz.ui.component.MetricsPanel?>
<?import com.algoviz.ui.component.PlaybackBar?>
<?import com.algoviz.ui.component.PseudocodePanel?>
<?import com.algoviz.ui.render.TreeCanvas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.algoviz.controller.TreeController" styleClass="module-root">

    <HBox fx:id="toolbar" styleClass="toolbar-row">
        <VBox spacing="4">
            <Label text="Value" styleClass="field-label"/>
            <TextField fx:id="valueField" promptText="e.g. 42" prefWidth="110"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Operation" styleClass="field-label"/>
            <HBox spacing="8">
                <Button fx:id="insertButton" text="Insert" styleClass="primary" onAction="#insert"/>
                <Button fx:id="searchButton" text="Search" onAction="#search"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#delete"/>
            </HBox>
        </VBox>
        <Region styleClass="separator-v" translateY="9"/>
        <VBox spacing="4">
            <Label text="Traversal" styleClass="field-label"/>
            <HBox spacing="8">
                <ComboBox fx:id="traversalBox" prefWidth="140"/>
                <Button fx:id="traverseButton" text="Traverse" onAction="#traverse"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="4">
            <Label text="Tree" styleClass="field-label"/>
            <HBox spacing="8">
                <Button fx:id="sampleButton" text="Sample tree" onAction="#sample"/>
                <Button fx:id="clearButton" text="Clear" styleClass="danger" onAction="#clearTree"/>
            </HBox>
        </VBox>
    </HBox>
    <Label fx:id="inputMessage" styleClass="inline-message"/>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.7">
        <VBox spacing="12" minWidth="520">
            <StackPane styleClass="canvas-card" VBox.vgrow="ALWAYS">
                <ScrollPane fx:id="canvasScroll" fitToWidth="true" fitToHeight="true">
                    <padding><Insets top="44"/></padding>
                    <TreeCanvas fx:id="canvas"/>
                </ScrollPane>
                <Legend fx:id="legend" StackPane.alignment="TOP_LEFT">
                    <StackPane.margin><Insets top="10" left="12"/></StackPane.margin>
                </Legend>
                <HBox fx:id="outputStrip" styleClass="output-strip" StackPane.alignment="BOTTOM_LEFT"
                      maxHeight="-Infinity" maxWidth="-Infinity" visible="false">
                    <StackPane.margin><Insets bottom="12" left="12" right="12"/></StackPane.margin>
                    <Label fx:id="outputTitle" text="Output"/>
                    <Label fx:id="outputValues" styleClass="output-values" wrapText="true"/>
                </HBox>
                <VBox fx:id="emptyHolder" StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"/>
            </StackPane>
            <PlaybackBar fx:id="playbackBar"/>
        </VBox>
        <ScrollPane fitToWidth="true" minWidth="340" hbarPolicy="NEVER">
            <VBox styleClass="side-panel">
                <ExplanationCard fx:id="explanationCard"/>
                <MetricsPanel fx:id="metricsPanel"/>
                <VBox styleClass="card">
                    <Label fx:id="codeTitle" text="PSEUDOCODE" styleClass="card-title"/>
                    <PseudocodePanel fx:id="pseudocodePanel"/>
                </VBox>
                <ComplexityCard fx:id="complexityCard"/>
                <VBox styleClass="card">
                    <Label text="ABOUT THIS TREE" styleClass="card-title"/>
                    <Label fx:id="aboutLabel" styleClass="doc-text" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </SplitPane>
</VBox>
