<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- Application shell: sidebar navigation, header and the module content host. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.algoviz.controller.MainController" styleClass="app-root">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar">
            <HBox fx:id="brandBox" styleClass="brand">
                <VBox fx:id="brandText" spacing="1">
                    <Label text="AlgoViz" styleClass="brand-name"/>
                    <Label text="Algorithm Visualizer" styleClass="brand-sub"/>
                </VBox>
            </HBox>
            <Label text="Workspace" styleClass="nav-section"/>
            <VBox fx:id="navOverview" spacing="2"/>
            <Label text="Visualizers" styleClass="nav-section"/>
            <VBox fx:id="navModules" spacing="2"/>
            <Label text="Learn" styleClass="nav-section"/>
            <VBox fx:id="navLearn" spacing="2"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox fx:id="navBottom" spacing="2"/>
            <Button fx:id="sidebarToggle" styleClass="sidebar-toggle" onAction="#toggleSidebar"/>
            <VBox fx:id="sidebarFooter" styleClass="sidebar-footer">
                <Label fx:id="versionLabel"/>
                <Label text="Offline · no account needed"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="header">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="breadcrumb" styleClass="header-breadcrumb"/>
                        <Label fx:id="titleLabel" styleClass="header-title"/>
                        <Label fx:id="subtitleLabel" styleClass="header-subtitle"/>
                    </VBox>
                    <HBox fx:id="headerActions" spacing="8" alignment="CENTER_RIGHT"/>
                    <HBox fx:id="statusChip" styleClass="status-chip">
                        <Circle fx:id="statusDot" radius="4" styleClass="status-dot"/>
                        <Label fx:id="statusLabel"/>
                    </HBox>
                    <Button fx:id="helpButton" styleClass="ghost, icon-button" onAction="#showHelp"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentHost" styleClass="content-host"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
